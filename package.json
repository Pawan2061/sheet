{
  "name": "google-sheets",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "start:backend":"cd /app/apps/http-backend && pnpm run start",
    "start:frontend":"cd /app/apps/react-app && pnpm start",
    "start:ws":"cd /app/apps/ws-server && pnpm start",
    "dev:frontend":"cd /app/apps/react-app && pnpm dev"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.3.3",
    "typescript": "5.5.4"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
  